# =============================================================================
# 智能档案管理系统 — baseline 外部依赖配置模板
# -----------------------------------------------------------------------------
# 用法：
#   cp deploy/.env.example deploy/.env
# 然后在 deploy/.env 中按需填入真实值。
#
# docker-compose.baseline.yml 通过 ${VAR:-默认值} 读取本文件，所有项默认关闭/空，
# 不创建 .env 也能零配置启动（外部依赖全走应用内降级）。
# 只有需要真实启用某项依赖时，才在 .env 中把对应开关置 true 并填入 token。
# =============================================================================

# ---- AI（DeepSeek）----
# 启用后可使用智能编目/检索等 AI 能力；关闭则走应用内降级
AI_ENABLED=false
# DeepSeek API Key（AI_ENABLED=true 时必填），例如 sk-xxxxxxxxxxxxxxxx
DEEPSEEK_API_KEY=
# 可选：自定义 API 入口与模型，留空用默认
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# ---- 病毒扫描（ClamAV）----
# 启用后上传文件经 ClamAV 扫描；关闭则跳过（baseline 不自带 clamav 容器，
# 如需启用请自行加入 compose 网络并在此配置地址）
FILE_SCAN_ENABLED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# ---- 阿里云短信（验证码）----
# 启用后走真实阿里云短信；关闭则使用 fallback 固定验证码
ALIYUN_SMS_ENABLED=false
ALIYUN_SMS_ACCESS_KEY=
ALIYUN_SMS_SECRET=

# ---- 宿主端口（可选）----
# baseline 前台宿主端口，默认 8081；如需避免冲突可在此覆盖
# ARCHIVE_HOST_PORT=8081
