# =============================================================================
# 智能档案管理系统 — 开发环境变量模板
# =============================================================================
# 使用: 复制为 .env 后按需修改
#   cp .env.example .env
# =============================================================================

# ── PostgreSQL ───────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=archive_db
DB_USER=archive_user
DB_PASSWORD=archive_pass_2024

# ── MinIO 对象存储 ──────────────────────────────────────────────────────────
# 注意: 使用 MINIO_ROOT_USER / MINIO_ROOT_PASSWORD（新版变量名）
# Spring Boot 侧连接时，ACCESS_KEY 对应 MINIO_ROOT_USER，SECRET_KEY 对应 MINIO_ROOT_PASSWORD
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
# MinIO 对外暴露端口（修改此处可避免端口冲突）
MINIO_API_PORT=9001
MINIO_CONSOLE_PORT=9002

# MinIO 客户端连接地址（Spring Boot 用）
# 容器内服务间通信用 http://minio:9001
# 宿主机 / IDE 直连用 http://localhost:9001
MINIO_ENDPOINT=http://localhost:9001

# ── Spring Boot ──────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev

# ── ClamAV 病毒扫描 ────────────────────────────────────────────────────────
# clamd TCP 无鉴权/无加密；docker-compose 仅绑定 127.0.0.1
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMD_STARTUP_TIMEOUT=1800
FRESHCLAM_CHECKS=24
